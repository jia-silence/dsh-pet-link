{
  "name": "dsh-pet-link",
  "version": "0.6.0",
  "description": "把桌宠 dsh-pet 桥接成 agent 工具，并给宠物一条反向通道：pet_say / pet_chat / pet_state / pet_watch / pet_look / pet_health / pet_notify / pet_ring / pet_link_info。宿主事件（回合结束、权限确认、等问题、生成失败）也会让桌宠弹气泡提醒。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "capture.py",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20.18",
    "dsh": ">=0.2.0-rc.2 <0.3.0 || 0.2.2-rc.1"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "pet"
  ],
  "license": "MIT"
}
